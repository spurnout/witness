<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\receipts-icon.ico</ApplicationIcon>
    <AssemblyName>Receipts</AssemblyName>
    <RootNamespace>GoatShot.App</RootNamespace>
    <Version Condition="'$(Version)' == ''">0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(ReceiptsDistribution)' == 'true' or '$(GoatShotDistribution)' == 'true'">
    <AssemblyMetadata Include="ReceiptsDistribution" Value="true" />
    <AssemblyMetadata Include="GoatShotDistribution" Value="true" />
    <AssemblyMetadata Include="ReceiptsBuildId" Value="$(ReceiptsBuildId)" Condition="'$(ReceiptsBuildId)' != ''" />
    <AssemblyMetadata Include="GoatShotBuildId" Value="$(ReceiptsBuildId)" Condition="'$(ReceiptsBuildId)' != ''" />
    <AssemblyMetadata Include="GoatShotBuildId" Value="$(GoatShotBuildId)" Condition="'$(ReceiptsBuildId)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\receipts-icon.ico" />
    <Resource Include="Assets\receipts-icon.png" />
    <EmbeddedResource Include="Assets\embedded-assets.manifest.json" LogicalName="Receipts.EmbeddedAssets.Manifest" />
    <EmbeddedResource Include="$(EmbeddedAssetsRoot)\embedded-assets.manifest.json"
                      Condition="'$(EmbeddedAssetsRoot)' != '' and Exists('$(EmbeddedAssetsRoot)\embedded-assets.manifest.json')"
                      LogicalName="Receipts.EmbeddedAssets.Manifest.Distribution" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AnimatedGif" Version="1.0.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="ZXing.Net.Bindings.Windows.Compatibility" Version="0.16.14" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
  </ItemGroup>

</Project>
