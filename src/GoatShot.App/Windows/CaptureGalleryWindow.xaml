<Window x:Class="GoatShot.App.Windows.CaptureGalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        xmlns:local="clr-namespace:GoatShot.App.Windows"
        Title="Receipts capture gallery"
        Width="820" Height="540" MinWidth="480" MinHeight="320"
        Background="{StaticResource WorkspaceSurfaceBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="CanResize" ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual"
        controls:AppWindowChrome.IsEnabled="True"
        controls:AppWindowChrome.CaptionHeight="40">
    <Window.Resources>
        <local:CaptureGalleryThumbnailConverter x:Key="ThumbnailConverter" />
        <Style x:Key="GalleryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource WorkspaceSecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource WorkspaceBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource WorkspaceElevatedBrush}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WorkspaceAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource WorkspaceAccentBrush}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptureButton" TargetType="Button" BasedOn="{StaticResource GalleryButton}">
            <Setter Property="Margin" Value="6,10" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource WorkspaceAccentBrush}" />
                    <Setter Property="Background" Value="#1B302F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource WorkspaceBorderBrush}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="40" Margin="16,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Receipts · Captures" Foreground="{StaticResource InkBrush}" FontSize="13"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Open library" Style="{StaticResource GalleryButton}"
                        Margin="0,0,8,0" VerticalAlignment="Center" Click="OpenLibrary_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Open capture library" />
                <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Style="{StaticResource GalleryButton}" Width="32" Height="32" Padding="0"
                        VerticalAlignment="Center" Click="Close_Click" ToolTip="Close gallery (Esc)"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close capture gallery" />
            </Grid>
            <DockPanel DockPanel.Dock="Bottom" Margin="16,10,16,12">
                <TextBlock x:Name="CaptureCountText" Foreground="{StaticResource WorkspaceSecondaryTextBrush}" FontSize="11" Margin="0,0,20,0" />
                <TextBlock x:Name="DismissHintText" Foreground="{StaticResource WorkspaceSecondaryTextBrush}" FontSize="11" TextAlignment="Right"
                           TextWrapping="Wrap" Text="Hover to keep open · Double-click an image for actions" />
            </DockPanel>
            <!-- Virtualize rows so opening a large history only decodes the visible thumbnails. -->
            <ListBox x:Name="CaptureRows" Margin="8,0,8,0" Padding="0" BorderThickness="0"
                     Background="Transparent" Focusable="False" IsTabStop="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     AutomationProperties.Name="Screenshot gallery">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsTabStop" Value="False" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding GalleryColumns, RelativeSource={RelativeSource AncestorType=Window}}" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource CaptureButton}" Click="Capture_Click"
                                            MouseDoubleClick="Capture_MouseDoubleClick" PreviewKeyDown="Capture_KeyDown"
                                            AutomationProperties.Name="{Binding Item.AccessibilityName}"
                                            AutomationProperties.HelpText="Click to select. Double-click or press Enter for image actions."
                                            ToolTip="{Binding Item.FileName}">
                                        <StackPanel>
                                            <Grid Height="100" Width="130">
                                                <TextBlock Text="Preview unavailable" Foreground="{StaticResource WorkspaceMutedTextBrush}" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Source, ElementName=ThumbnailImage}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Image x:Name="ThumbnailImage" Source="{Binding Item, Converter={StaticResource ThumbnailConverter}}"
                                                       Stretch="Uniform" HorizontalAlignment="Stretch" />
                                            </Grid>
                                            <TextBlock Text="{Binding Item.FileName}" Foreground="{StaticResource WorkspaceSecondaryTextBrush}" FontSize="10"
                                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Width="130" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
