<Window x:Class="GoatShot.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoatShot Settings"
        Width="860"
        Height="700"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#081016">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0B151C"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GoatShot Settings"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock Text="Grouped controls for capture, recording, sharing, automation, plugins, AI, and local privacy posture."
                               Foreground="{StaticResource MutedInkBrush}"
                               TextWrapping="Wrap"
                               Margin="0,2,20,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Jump to section"
                               Foreground="{StaticResource MutedInkBrush}"
                               FontSize="12"
                               Margin="0,0,0,4" />
                    <ComboBox x:Name="SettingsSectionBox"
                              Background="#0B151C"
                              Foreground="#F4FAFF"
                              AutomationProperties.Name="Settings section"
                              SelectionChanged="SettingsSection_SelectionChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="SettingsScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="18,14,18,0">
            <StackPanel>
                <TextBlock x:Name="GeneralSettingsSection"
                           Text="General"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <TextBlock Text="Library root" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="LibraryRootBox" Margin="0,6,0,14" />
                <TextBlock Text="Filename template" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="FileNameTemplateBox" Margin="0,6,0,6" />
                <TextBlock Text="{}{date}, {time}, {datetime}, {capture_type}, {app}, {process}, {window_title}, {monitor}, {width}, {height}, {counter}, {project}"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />
                <CheckBox x:Name="CopyAfterCaptureBox" Content="Copy image to clipboard after capture" />
                <CheckBox x:Name="IncludeCursorBox" Content="Include cursor in captures" />
                <TextBlock Text="Region capture context padding" Foreground="{StaticResource MutedInkBrush}" Margin="0,10,0,0" />
                <TextBox x:Name="CaptureContextPaddingBox"
                         Margin="0,6,0,6"
                         AutomationProperties.Name="Region capture context padding" />
                <TextBlock Text="Adds pixels around region selections after snapping. Use 0-200."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <CheckBox x:Name="PrivateModeBox" Content="Private capture mode: save temporary files but do not index workspace history" />
                <CheckBox x:Name="RunAtStartupBox" Content="Run GoatShot when I sign in to Windows" />
                <TextBlock Text="Effective managed policy" Foreground="{StaticResource MutedInkBrush}" Margin="0,10,0,0" />
                <TextBlock x:Name="ManagedPolicyStatusText"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10"
                           AutomationProperties.Name="Effective managed policy status" />
                <TextBlock Text="OCR language tag" Foreground="{StaticResource MutedInkBrush}" Margin="0,10,0,0" />
                <TextBox x:Name="OcrLanguageBox" Margin="0,6,0,6" />
                <TextBlock Text="Leave blank to use Windows profile languages, or enter a tag such as en-US."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}" />

                <TextBlock x:Name="RecordingSettingsSection"
                           Text="Recording"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <CheckBox x:Name="PreferProductionRecorderBox" Content="Prefer production recorder when available" />
                <CheckBox x:Name="PreferHevcRecorderBox"
                          Content="Prefer HEVC when Media Foundation support is available"
                          Margin="0,6,0,0" />
                <TextBlock Text="H.264 remains the default. HEVC is used only when explicitly enabled and a local Media Foundation HEVC encoder is reported."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,4,0,10" />
                <TextBlock Text="MP4 quality profile" Foreground="{StaticResource MutedInkBrush}" Margin="0,10,0,0" />
                <ComboBox x:Name="RecordingQualityBox"
                          Margin="0,6,0,10"
                          Background="#0B151C"
                          Foreground="#F4FAFF">
                    <ComboBoxItem Content="Small" />
                    <ComboBoxItem Content="Balanced" />
                    <ComboBoxItem Content="High quality" />
                    <ComboBoxItem Content="Archive" />
                </ComboBox>
                <TextBlock Text="Frames per second" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="RecordingFpsBox" Margin="0,6,0,10" />
                <TextBlock Text="Target size" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="RecordingSizeBox" Margin="0,6,0,6" />
                <TextBlock Text="Use WIDTHxHEIGHT, WIDTHxauto, or leave blank for source/max fallback size."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="Bitrate" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="RecordingBitrateBox" Margin="0,6,0,6" />
                <TextBlock Text="Optional. Examples: 6000k, 8M. Blank uses the selected quality profile CRF."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <CheckBox x:Name="RecordingMicBox" Content="Request microphone recording" />
                <TextBlock Text="Microphone device" Foreground="{StaticResource MutedInkBrush}" Margin="0,6,0,0" />
                <ComboBox x:Name="RecordingMicDeviceBox"
                          Margin="0,6,0,10"
                          Background="#0B151C"
                          Foreground="#F4FAFF" />
                <TextBlock Text="Microphone gain" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="RecordingMicGainBox" Margin="0,6,0,6" />
                <CheckBox x:Name="RecordingMicMutedBox"
                          Content="Mute microphone track"
                          Margin="0,0,0,10" />
                <CheckBox x:Name="RecordingSystemAudioBox" Content="Request system audio recording" />
                <TextBlock Text="System audio device" Foreground="{StaticResource MutedInkBrush}" Margin="0,6,0,0" />
                <ComboBox x:Name="RecordingSystemAudioDeviceBox"
                          Margin="0,6,0,10"
                          Background="#0B151C"
                          Foreground="#F4FAFF" />
                <TextBlock Text="System audio gain" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="RecordingSystemAudioGainBox" Margin="0,6,0,6" />
                <CheckBox x:Name="RecordingSystemAudioMutedBox"
                          Content="Mute system audio track"
                          Margin="0,0,0,10" />
                <TextBlock Text="Noise gate threshold dB" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="RecordingNoiseGateBox" Margin="0,6,0,6" />
                <TextBlock Text="Use -96 to disable, or values like -55 for light room-noise gating."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <CheckBox x:Name="RecordingWebcamBox" Content="Request webcam overlay" />
                <TextBlock Text="Webcam device" Foreground="{StaticResource MutedInkBrush}" Margin="0,6,0,0" />
                <ComboBox x:Name="RecordingWebcamDeviceBox"
                          Margin="0,6,0,10"
                          Background="#0B151C"
                          Foreground="#F4FAFF" />
                <Button Content="Refresh recording devices"
                        Click="RefreshRecordingDevices_Click"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,8" />
                <TextBlock x:Name="RecordingDeviceStatusText"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <CheckBox x:Name="RecordingCountdownBox" Content="Show countdown before recording" />
                <CheckBox x:Name="RecordingBorderBox" Content="Show recording border" />
                <CheckBox x:Name="RecordingTimerBox" Content="Show recording timer" />
                <CheckBox x:Name="RecordingKeystrokeBox" Content="Show keystroke overlay" />
                <TextBlock Text="Timer position" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" />
                <ComboBox x:Name="RecordingTimerPositionBox"
                          Margin="0,6,0,8"
                          Background="#0B151C"
                          Foreground="#F4FAFF">
                    <ComboBoxItem Content="TopLeft" />
                    <ComboBoxItem Content="TopCenter" />
                    <ComboBoxItem Content="TopRight" />
                    <ComboBoxItem Content="BottomLeft" />
                    <ComboBoxItem Content="BottomCenter" />
                    <ComboBoxItem Content="BottomRight" />
                </ComboBox>
                <TextBlock Text="Keystroke position" Foreground="{StaticResource MutedInkBrush}" />
                <ComboBox x:Name="RecordingKeystrokePositionBox"
                          Margin="0,6,0,8"
                          Background="#0B151C"
                          Foreground="#F4FAFF">
                    <ComboBoxItem Content="TopLeft" />
                    <ComboBoxItem Content="TopCenter" />
                    <ComboBoxItem Content="TopRight" />
                    <ComboBoxItem Content="BottomLeft" />
                    <ComboBoxItem Content="BottomCenter" />
                    <ComboBoxItem Content="BottomRight" />
                </ComboBox>
                <TextBlock Text="Overlay badge size" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="RecordingOverlayBadgeSizeBox" Margin="0,6,0,8" />
                <TextBlock Text="Overlay badge style" Foreground="{StaticResource MutedInkBrush}" />
                <ComboBox x:Name="RecordingOverlayStyleBox"
                          Margin="0,6,0,8"
                          Background="#0B151C"
                          Foreground="#F4FAFF">
                    <ComboBoxItem Content="Neon" />
                    <ComboBoxItem Content="HighContrast" />
                    <ComboBoxItem Content="Subtle" />
                </ComboBox>
                <TextBlock Text="MP4 can use native Media Foundation production encoding when WGC/D3D and H.264 encoder prerequisites are available. Captured mic/system-audio WAV payloads can be muxed as AAC; webcam overlay can precompose bounded, periodically refreshed native camera frames, with FFmpeg DirectShow fallback still available. The main recording panel includes live desktop webcam preview."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,6,0,14" />

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}" />

                <TextBlock x:Name="SharingSettingsSection"
                           Text="Sharing"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <TextBlock Text="Provider readiness"
                           Foreground="{StaticResource MutedInkBrush}" />
                <TextBlock x:Name="ProviderSetupHeadlineText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,4,0,8"
                           AutomationProperties.Name="Provider readiness summary" />
                <UniformGrid x:Name="ProviderSetupSummaryGrid"
                             Columns="3"
                             Margin="0,0,0,8" />
                <TextBlock x:Name="ProviderSetupDetailText"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           AutomationProperties.Name="Provider readiness detail" />
                <TextBlock Text="Detailed local diagnostics: goatshot providers --not-ready --json. OAuth consent, refresh behavior, and live account uploads remain separate parked proof lanes."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />
                <TextBlock Text="Default share destination" Foreground="{StaticResource MutedInkBrush}" />
                <ComboBox x:Name="DefaultShareBox"
                          Margin="0,6,0,14"
                          Background="#0B151C"
                          Foreground="#F4FAFF">
                    <ComboBoxItem Content="Clipboard image" />
                    <ComboBoxItem Content="Clipboard file" />
                    <ComboBoxItem Content="Clipboard path" />
                    <ComboBoxItem Content="Markdown image link" />
                    <ComboBoxItem Content="Local folder" />
                    <ComboBoxItem Content="Email attachment" />
                    <ComboBoxItem Content="S3-compatible" />
                    <ComboBoxItem Content="Imgur" />
                    <ComboBoxItem Content="SFTP" />
                    <ComboBoxItem Content="Cloudinary" />
                    <ComboBoxItem Content="Dropbox" />
                    <ComboBoxItem Content="Google Drive" />
                    <ComboBoxItem Content="Google Photos" />
                    <ComboBoxItem Content="OneDrive" />
                    <ComboBoxItem Content="YouTube" />
                    <ComboBoxItem Content="OneNote" />
                    <ComboBoxItem Content="Linear" />
                    <ComboBoxItem Content="GitHub Issues" />
                    <ComboBoxItem Content="Jira" />
                    <ComboBoxItem Content="Azure DevOps" />
                    <ComboBoxItem Content="Slack" />
                    <ComboBoxItem Content="Discord" />
                    <ComboBoxItem Content="Microsoft Teams" />
                    <ComboBoxItem Content="WebDAV" />
                    <ComboBoxItem Content="FTP/FTPS" />
                    <ComboBoxItem Content="Custom script" />
                    <ComboBoxItem Content="Custom webhook" />
                </ComboBox>
                <CheckBox x:Name="ConfirmUploadBox" Content="Ask before upload or external share" />
                <CheckBox x:Name="QueueBackgroundProcessingBox" Content="Process queued uploads in the background while GoatShot is running" />
                <TextBlock Text="Queue poll interval seconds" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="QueuePollSecondsBox" Margin="0,6,0,6" />
                <TextBlock Text="Background processing only runs for items explicitly queued by the operator."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />
                <TextBlock Text="Local export folder" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="LocalExportFolderBox" Margin="0,6,0,14" />
                <TextBlock Text="Custom script command" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="CustomScriptBox"
                         AcceptsReturn="True"
                         Height="74"
                         Margin="0,6,0,6" />
                <TextBlock Text="Available placeholders: {file}, {metadata}, {ocr}, {id}, {capture_type}"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />
                <TextBlock Text="Custom webhook URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="CustomWebhookBox" Margin="0,6,0,14" />

                <TextBlock Text="Slack incoming webhook URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SlackWebhookBox" Margin="0,6,0,6" />
                <TextBlock Text="Slack message template" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SlackMessageTemplateBox" Margin="0,6,0,10" />
                <TextBlock Text="Discord webhook URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="DiscordWebhookBox" Margin="0,6,0,6" />
                <TextBlock Text="Discord message template" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="DiscordMessageTemplateBox" Margin="0,6,0,10" />
                <TextBlock Text="Microsoft Teams incoming webhook URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="TeamsWebhookBox" Margin="0,6,0,6" />
                <TextBlock Text="Microsoft Teams message template" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="TeamsMessageTemplateBox" Margin="0,6,0,6" />
                <TextBlock Text="Webhook message placeholders: {provider}, {file}, {id}, {capture_type}, {bytes}, {width}, {height}, {created_at}. Slack and Teams incoming webhooks send notifications only; Discord uploads the file."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <TextBlock Text="S3-compatible endpoint" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="S3EndpointBox" Margin="0,6,0,6" />
                <TextBlock Text="Example: https://s3.amazonaws.com, https://accountid.r2.cloudflarestorage.com, or http://localhost:9000"
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="S3 bucket" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="S3BucketBox" Margin="0,6,0,10" />
                <TextBlock Text="S3 region" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="S3RegionBox" Margin="0,6,0,10" />
                <TextBlock Text="S3 key prefix" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="S3PrefixBox" Margin="0,6,0,10" />
                <TextBlock Text="S3 public base URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="S3PublicBaseUrlBox" Margin="0,6,0,6" />
                <TextBlock Text="Optional. When set, successful S3 uploads copy a share URL. Without it, GoatShot only records the s3:// bucket/key."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="S3 access key ID" Foreground="{StaticResource MutedInkBrush}" />
                <PasswordBox x:Name="S3AccessKeyBox"
                             Background="#0B151C"
                             Foreground="#F4FAFF"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8"
                             Margin="0,6,0,8" />
                <TextBlock Text="S3 secret access key" Foreground="{StaticResource MutedInkBrush}" />
                <PasswordBox x:Name="S3SecretKeyBox"
                             Background="#0B151C"
                             Foreground="#F4FAFF"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8"
                             Margin="0,6,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Save S3 keys" Click="SaveS3Keys_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Clear S3 keys" Click="ClearS3Keys_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock x:Name="S3KeyStatusText"
                           Foreground="{StaticResource MutedInkBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <TextBlock Text="Imgur API endpoint" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="ImgurEndpointBox" Margin="0,6,0,6" />
                <TextBlock Text="Default: https://api.imgur.com/3/image. Use a custom endpoint only for compatible gateways or local testing."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="Imgur Client ID" Foreground="{StaticResource MutedInkBrush}" />
                <PasswordBox x:Name="ImgurClientIdBox"
                             Background="#0B151C"
                             Foreground="#F4FAFF"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8"
                             Margin="0,6,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Save Imgur Client ID" Click="SaveImgurClientId_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Clear Imgur Client ID" Click="ClearImgurClientId_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock x:Name="ImgurKeyStatusText"
                           Foreground="{StaticResource MutedInkBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <TextBlock Text="SFTP host" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SftpHostBox" Margin="0,6,0,10" />
                <TextBlock Text="SFTP port" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SftpPortBox" Margin="0,6,0,10" />
                <TextBlock Text="SFTP username" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SftpUsernameBox" Margin="0,6,0,10" />
                <TextBlock Text="SFTP remote directory" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SftpRemoteDirectoryBox" Margin="0,6,0,6" />
                <TextBlock Text="The remote directory should already exist unless the server allows creating it. Unknown host keys must be trusted through OpenSSH before non-interactive upload."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="SFTP private key path" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SftpPrivateKeyPathBox" Margin="0,6,0,6" />
                <TextBlock Text="Optional. Leave blank to use OpenSSH defaults, ssh-agent, or server-side account policy."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="SFTP public base URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SftpPublicBaseUrlBox" Margin="0,6,0,6" />
                <TextBlock Text="Optional. When set, successful SFTP uploads copy a share URL by appending the uploaded file name."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="SFTP executable path" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="SftpExecutablePathBox" Margin="0,6,0,6" />
                <TextBlock Text="Advanced. Leave blank to use OpenSSH sftp.exe from PATH or C:\Windows\System32\OpenSSH."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <TextBlock Text="WebDAV base URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="WebDavBaseUrlBox" Margin="0,6,0,10" />
                <TextBlock Text="WebDAV remote directory" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="WebDavRemoteDirectoryBox" Margin="0,6,0,10" />
                <TextBlock Text="WebDAV username" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="WebDavUsernameBox" Margin="0,6,0,10" />
                <TextBlock Text="WebDAV public base URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="WebDavPublicBaseUrlBox" Margin="0,6,0,6" />
                <TextBlock Text="Optional. When set, successful WebDAV uploads copy a share URL by appending the uploaded file name."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="WebDAV password" Foreground="{StaticResource MutedInkBrush}" />
                <PasswordBox x:Name="WebDavPasswordBox"
                             Background="#0B151C"
                             Foreground="#F4FAFF"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8"
                             Margin="0,6,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Save WebDAV password" Click="SaveWebDavPassword_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Clear WebDAV password" Click="ClearWebDavPassword_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock x:Name="WebDavPasswordStatusText"
                           Foreground="{StaticResource MutedInkBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <TextBlock Text="FTP/FTPS host" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="FtpHostBox" Margin="0,6,0,10" />
                <TextBlock Text="FTP/FTPS port" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="FtpPortBox" Margin="0,6,0,10" />
                <CheckBox x:Name="FtpUseFtpsBox" Content="Use FTPS explicit TLS" />
                <TextBlock Text="FTP/FTPS username" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="FtpUsernameBox" Margin="0,6,0,10" />
                <TextBlock Text="FTP/FTPS remote directory" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="FtpRemoteDirectoryBox" Margin="0,6,0,10" />
                <TextBlock Text="FTP/FTPS public base URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="FtpPublicBaseUrlBox" Margin="0,6,0,6" />
                <TextBlock Text="Optional. When set, successful FTP/FTPS uploads copy a share URL by appending the uploaded file name."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="FTP/FTPS password" Foreground="{StaticResource MutedInkBrush}" />
                <PasswordBox x:Name="FtpPasswordBox"
