                           Margin="0,0,0,14" />

                <TextBlock Text="Azure DevOps base URL" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="AzureDevOpsBaseUrlBox" Margin="0,6,0,6" />
                <TextBlock Text="Default: https://dev.azure.com. Advanced override supports Azure DevOps Server-compatible endpoints."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="Azure DevOps organization" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="AzureDevOpsOrganizationBox" Margin="0,6,0,10" />
                <TextBlock Text="Azure DevOps project" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="AzureDevOpsProjectBox" Margin="0,6,0,10" />
                <TextBlock Text="Azure DevOps work item type" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="AzureDevOpsWorkItemTypeBox" Margin="0,6,0,10" />
                <TextBlock Text="Azure DevOps title template" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="AzureDevOpsTitleTemplateBox" Margin="0,6,0,10" />
                <TextBlock Text="Azure DevOps tags" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="AzureDevOpsTagsBox" Margin="0,6,0,10" />
                <TextBlock Text="Azure DevOps assigned to" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="AzureDevOpsAssignedToBox" Margin="0,6,0,6" />
                <TextBlock Text="Optional identity value accepted by the Azure DevOps project, such as an email address or display name."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10" />
                <TextBlock Text="Azure DevOps personal access token" Foreground="{StaticResource MutedInkBrush}" />
                <PasswordBox x:Name="AzureDevOpsPatBox"
                             Background="#0B151C"
                             Foreground="#F4FAFF"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8"
                             Margin="0,6,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Save Azure DevOps PAT" Click="SaveAzureDevOpsPat_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Clear Azure DevOps PAT" Click="ClearAzureDevOpsPat_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock x:Name="AzureDevOpsPatStatusText"
                           Foreground="{StaticResource MutedInkBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />

                <TextBlock Text="Upload denylist processes, one per line" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="UploadDenylistBox"
                         AcceptsReturn="True"
                         Height="70"
                         Margin="0,6,0,14" />

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}" />

                <TextBlock x:Name="AutomationSettingsSection"
                           Text="Automation / Watch Folders"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <CheckBox x:Name="EnableWatchFoldersBox" Content="Enable watch folders while GoatShot is running" />
                <CheckBox x:Name="WatchSubdirectoriesBox" Content="Include subdirectories" />
                <CheckBox x:Name="WatchAutoImportBox" Content="Auto-import images and videos added to watch folders" />
                <CheckBox x:Name="WatchCopyAfterImportBox" Content="Copy imported image to clipboard" />
                <CheckBox x:Name="WatchStripMetadataBox" Content="Create metadata-stripped PNG copy for imported images" />
                <CheckBox x:Name="WatchShareAfterImportBox" Content="Run quick share after importing watched files" />
                <TextBlock Text="Watch folders, one per line" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="WatchFoldersBox"
                         AcceptsReturn="True"
                         Height="82"
                         AutomationProperties.Name="Watch folders"
                         Margin="0,6,0,14" />
                <Border Background="#101B23"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,6,0,14">
                    <StackPanel>
                        <TextBlock Text="Workflow rules"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="WorkflowTemplateBox"
                                      Background="#0B151C"
                                      Foreground="#F4FAFF"
                                      AutomationProperties.Name="Starter workflow template" />
                            <Button Grid.Column="1"
                                    Content="Add template"
                                    Margin="10,0,0,0"
                                    Click="AddAutomationTemplate_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="AutomationRuleListBox"
                                     Height="128"
                                     Background="#0B151C"
                                     Foreground="#F4FAFF"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     SelectionChanged="AutomationRuleList_SelectionChanged"
                                     AutomationProperties.Name="Saved workflow rules" />
                            <UniformGrid Grid.Column="1"
                                         Columns="2"
                                         Rows="2"
                                         Margin="10,0,0,0">
                                <Button Content="New rule"
                                        Click="NewAutomationRule_Click"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Content="Duplicate rule"
                                        Click="DuplicateAutomationRule_Click"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Content="Delete rule"
                                        Click="DeleteAutomationRule_Click"
                                        Style="{StaticResource SecondaryButton}" />
                                <Button Content="Update rule"
                                        Click="ApplyAutomationRuleEditor_Click"
                                        Style="{StaticResource SecondaryButton}" />
                            </UniformGrid>
                        </Grid>
                        <TextBlock x:Name="RuleManagerStatusText"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Workflow rule manager status"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,0,0,10" />
                        <Separator Margin="0,0,0,10" Background="{StaticResource BorderBrush}" />
                        <TextBlock Text="Rule editor"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <CheckBox x:Name="RuleEnabledBox" Content="Enable this rule" />
                        <TextBlock Text="Rule name" Foreground="{StaticResource MutedInkBrush}" Margin="0,8,0,0" />
                        <TextBox x:Name="RuleNameBox"
                                 AutomationProperties.Name="Rule name"
                                 Margin="0,6,0,8" />
                        <TextBlock Text="Trigger" Foreground="{StaticResource MutedInkBrush}" />
                        <ComboBox x:Name="RuleTriggerBox"
                                  Margin="0,6,0,8"
                                  Background="#0B151C"
                                  AutomationProperties.Name="Rule trigger"
                                  Foreground="#F4FAFF">
                            <ComboBoxItem Content="CaptureCreated" />
                            <ComboBoxItem Content="CaptureEdited" />
                            <ComboBoxItem Content="FileAddedToWatchFolder" />
                            <ComboBoxItem Content="RecordingCompleted" />
                            <ComboBoxItem Content="OcrCompleted" />
                            <ComboBoxItem Content="UploadCompleted" />
                            <ComboBoxItem Content="AiActionCompleted" />
                        </ComboBox>
                        <TextBlock Text="Conditions" Foreground="{StaticResource MutedInkBrush}" />
                        <UniformGrid Columns="2" Margin="0,6,0,8">
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Source app contains" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <TextBox x:Name="RuleSourceAppBox"
                                         AutomationProperties.Name="Source app condition"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,8">
                                <TextBlock Text="Window title contains" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <TextBox x:Name="RuleWindowTitleBox"
                                         AutomationProperties.Name="Window title condition"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Capture kind" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <ComboBox x:Name="RuleCaptureKindBox"
                                          Margin="0,4,0,0"
                                          Background="#0B151C"
                                          AutomationProperties.Name="Capture kind condition"
                                          Foreground="#F4FAFF">
                                    <ComboBoxItem Content="Any" />
                                    <ComboBoxItem Content="Region" />
                                    <ComboBoxItem Content="Fullscreen" />
                                    <ComboBoxItem Content="AllMonitors" />
                                    <ComboBoxItem Content="ActiveWindow" />
                                    <ComboBoxItem Content="ScrollingWindow" />
                                    <ComboBoxItem Content="ActiveMonitor" />
                                    <ComboBoxItem Content="FixedRegion" />
                                    <ComboBoxItem Content="RecordingGif" />
                                    <ComboBoxItem Content="RecordingMp4" />
                                    <ComboBoxItem Content="Imported" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,8">
                                <TextBlock Text="Monitor contains" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <TextBox x:Name="RuleMonitorContainsBox"
                                         AutomationProperties.Name="Monitor condition"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Hotkey/profile name" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <TextBox x:Name="RuleHotkeyProfileBox"
                                         AutomationProperties.Name="Hotkey or workflow profile condition"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,8">
                                <TextBlock Text="File extension" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <TextBox x:Name="RuleFileExtensionBox"
                                         AutomationProperties.Name="File extension condition"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Min bytes" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <TextBox x:Name="RuleMinFileSizeBox"
                                         AutomationProperties.Name="Minimum file size condition"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="8,0,0,8">
                                <TextBlock Text="Max bytes" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <TextBox x:Name="RuleMaxFileSizeBox"
                                         AutomationProperties.Name="Maximum file size condition"
                                         Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="OCR text contains" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBox x:Name="RuleOcrContainsBox"
                                 AutomationProperties.Name="OCR text condition"
                                 Margin="0,6,0,8" />
                        <TextBlock Text="Sensitive-data condition" Foreground="{StaticResource MutedInkBrush}" />
                        <ComboBox x:Name="RuleSensitiveConditionBox"
                                  Margin="0,6,0,10"
                                  Background="#0B151C"
                                  AutomationProperties.Name="Sensitive-data condition"
                                  Foreground="#F4FAFF">
                            <ComboBoxItem Content="Any" />
                            <ComboBoxItem Content="Requires sensitive data" />
                            <ComboBoxItem Content="Excludes sensitive data" />
                        </ComboBox>
                        <TextBlock Text="Actions" Foreground="{StaticResource MutedInkBrush}" />
                        <UniformGrid Columns="2" Margin="0,6,0,4">
                            <CheckBox x:Name="RuleCopyCaptureBox" Content="Copy image" />
                            <CheckBox x:Name="RuleCopyFileBox" Content="Copy file" />
                            <CheckBox x:Name="RuleCopyPathBox" Content="Copy path" />
                            <CheckBox x:Name="RuleSaveFolderBox" Content="Save to folder" />
                            <CheckBox x:Name="RuleRunOcrBox" Content="Run OCR" />
                            <CheckBox x:Name="RuleRedactSensitiveBox" Content="Redact OCR secrets" />
                            <CheckBox x:Name="RuleApplyImageEffectBox" Content="Apply image effect" />
                            <CheckBox x:Name="RuleStripCaptureBox" Content="Strip metadata" />
                            <CheckBox x:Name="RuleShareCaptureBox" Content="Quick share" />
                            <CheckBox x:Name="RuleGenerateDocumentBox" Content="Generate bug report" />
                            <CheckBox x:Name="RuleCustomScriptBox" Content="Custom script" />
                            <CheckBox x:Name="RuleCustomWebhookBox" Content="Custom webhook" />
                            <CheckBox x:Name="RuleNotifyBox" Content="Status notification" />
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,6,0,4">
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Image effect mode" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <ComboBox x:Name="RuleImageEffectModeBox"
                                          Margin="0,4,0,0"
                                          Background="#0B151C"
                                          AutomationProperties.Name="Image effect mode"
                                          Foreground="#F4FAFF">
                                    <ComboBoxItem Content="Solid" />
                                    <ComboBoxItem Content="Blur" />
                                    <ComboBoxItem Content="Pixelate" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="8,0,0,8">
                                <TextBlock Text="Image effect region" Foreground="{StaticResource MutedInkBrush}" FontSize="12" />
                                <TextBox x:Name="RuleImageEffectRegionBox"
                                         AutomationProperties.Name="Image effect region"
                                         ToolTip="Use full or x,y,width,height percentages."
                                         Margin="0,4,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Export profile" Click="ExportWorkflowProfile_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Import profile" Click="ImportWorkflowProfile_Click" Style="{StaticResource SecondaryButton}" />
                </StackPanel>
                <TextBlock Text="Workflow profile export omits custom script, webhook, and DPAPI credential values by default."
                           Foreground="{StaticResource MutedInkBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4" />

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}" />

                <TextBlock x:Name="PluginsSettingsSection"
                           Text="Plugins"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <Border Background="#101B23"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Remote plugin update check"
                                   FontWeight="Bold"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Passive registry summary only. GoatShot does not install, trust, enable, allowlist, or execute plugin code from this surface."
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Registry JSON path or URL" Foreground="{StaticResource MutedInkBrush}" />
                        <Grid Margin="0,6,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PluginUpdateRegistryBox"
                                     AutomationProperties.Name="Plugin update registry path or URL"
                                     Margin="0,0,10,0" />
                            <Button Grid.Column="1"
                                    Content="Refresh"
                                    Click="RefreshPluginUpdates_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Grid.Column="2"
                                    Content="Copy CLI"
                                    Click="CopyPluginUpdatesCli_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Grid.Column="3"
                                    Content="Open staging"
                                    Click="OpenPluginStagingFolder_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <TextBlock x:Name="PluginUpdateStatusText"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Plugin update status"
                                   AutomationProperties.LiveSetting="Polite"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="PluginUpdateCountsText"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Plugin update counts"
                                   Margin="0,0,0,8" />
                        <ListBox x:Name="PluginUpdateSummaryList"
                                 Height="180"
                                 Background="#0B151C"
                                 Foreground="#F4FAFF"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 AutomationProperties.Name="Plugin update summary list"
                                 Margin="0,0,0,8" />
                        <TextBlock x:Name="PluginUpdateNextActionsText"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Plugin update next actions"
                                   Margin="0,0,0,6" />
                    </StackPanel>
                </Border>

                <Separator Margin="0,16,0,16" Background="{StaticResource BorderBrush}" />

                <TextBlock x:Name="AiSettingsSection"
                           Text="AI / Gemini"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,12" />
                <CheckBox x:Name="AiEnabledBox" Content="Enable AI features after provider configuration" />
                <CheckBox x:Name="ConfirmAiBox" Content="Ask before sending a screenshot to AI" />
                <TextBlock Text="Gemini API endpoint" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="GeminiEndpointBox" Margin="0,6,0,14" />
                <TextBlock Text="Default Gemini image model" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="GeminiDefaultModelBox" Margin="0,6,0,14" />
                <TextBlock Text="Default Gemini speech-to-text model" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="GeminiSpeechModelBox" Margin="0,6,0,14" />
                <TextBlock Text="Gemini API key" Foreground="{StaticResource MutedInkBrush}" />
                <PasswordBox x:Name="GeminiApiKeyBox"
                             Background="#0B151C"
                             Foreground="#F4FAFF"
                             BorderBrush="{StaticResource BorderBrush}"
                             Padding="8"
                             Margin="0,6,0,8" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Save key" Click="SaveGeminiKey_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Clear key" Click="ClearGeminiKey_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Validate" Click="ValidateGemini_Click" />
                </StackPanel>
                <TextBlock x:Name="GeminiKeyStatusText"
                           Foreground="{StaticResource MutedInkBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14" />
                <TextBlock Text="Gemini model manifest path" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="GeminiManifestBox" Margin="0,6,0,14" />
                <TextBlock Text="AI denylist processes, one per line" Foreground="{StaticResource MutedInkBrush}" />
                <TextBox x:Name="AiDenylistBox"
                         AcceptsReturn="True"
                         Height="70"
                         Margin="0,6,0,14" />

                <Border Background="#101B23"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,8,0,0">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource MutedInkBrush}"
                               Text="Gemini keys are saved with Windows DPAPI for the current user and are not written to settings JSON. Screenshots leave the machine only when AI is enabled and you run an image AI action. Video-intel AI sends redacted transcript text, not the video file." />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="18,14,18,18">
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource SecondaryButton}" />
            <Button Content="Save" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
