<Window x:Class="GoatShot.App.Windows.ProofSceneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipts Proof Scene"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        Background="#081016"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        AutomationProperties.Name="Receipts safe proof scene"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        controls:AppWindowChrome.IsEnabled="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ProofRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Margin" Value="0,0,14,8" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" />

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Safe proof scene"
                           FontSize="28"
                           FontWeight="Bold" />
                <TextBlock Text="Private-free Receipts content for desktop, capture, and recording validation."
                           Foreground="{StaticResource MutedInkBrush}"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    MinWidth="260"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Live status"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText"
                               Text="Proof scene ready"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Proof scene live status"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Keyboard targets"
                                   Style="{StaticResource SectionTitle}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Case" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,12,10" />
                            <TextBox x:Name="CaseNameBox"
                                     Grid.Row="0"
                                     Grid.Column="1"
                                     Text="GS-VAL-001"
                                     Margin="0,0,0,10"
                                     AutomationProperties.Name="Proof case name" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Mode" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,12,10" />
                            <WrapPanel Grid.Row="1"
                                       Grid.Column="1"
                                       Margin="0,0,0,8">
                                <RadioButton Content="Keyboard"
                                             GroupName="ProofMode"
                                             IsChecked="True"
                                             Style="{StaticResource ProofRadio}"
                                             AutomationProperties.Name="Proof mode keyboard" />
                                <RadioButton Content="Scaling"
                                             GroupName="ProofMode"
                                             Style="{StaticResource ProofRadio}"
                                             AutomationProperties.Name="Proof mode scaling" />
                                <RadioButton Content="Contrast"
                                             GroupName="ProofMode"
                                             Style="{StaticResource ProofRadio}"
                                             AutomationProperties.Name="Proof mode contrast" />
                                <RadioButton Content="Capture"
                                             GroupName="ProofMode"
                                             Style="{StaticResource ProofRadio}"
                                             AutomationProperties.Name="Proof mode capture" />
                                <RadioButton Content="Recording"
                                             GroupName="ProofMode"
                                             Style="{StaticResource ProofRadio}"
                                             AutomationProperties.Name="Proof mode recording" />
                            </WrapPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Result" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,12,10" />
                            <UniformGrid Grid.Row="2"
                                         Grid.Column="1"
                                         Columns="2"
                                         Margin="0,0,0,8">
                                <CheckBox Content="Ready"
                                          IsChecked="True"
                                          AutomationProperties.Name="Proof result ready" />
                                <CheckBox Content="Focus visible"
                                          IsChecked="True"
                                          AutomationProperties.Name="Proof result focus visible" />
                                <CheckBox Content="Text fits"
                                          AutomationProperties.Name="Proof result text fits" />
                                <CheckBox Content="Contrast readable"
                                          AutomationProperties.Name="Proof result contrast readable" />
                            </UniformGrid>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Notes" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,12,0" />
                            <TextBox x:Name="NotesBox"
                                     Grid.Row="3"
                                     Grid.Column="1"
                                     MinHeight="92"
                                     Text="Safe sample notes for local proof only."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     AutomationProperties.Name="Proof notes" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="State controls"
                                   Style="{StaticResource SectionTitle}" />

                        <CheckBox x:Name="ConsentCheck"
                                  Content="Safe desktop content confirmed"
                                  IsChecked="True"
                                  AutomationProperties.Name="Safe desktop content confirmed" />
                        <CheckBox x:Name="AudioCheck"
                                  Content="Synthetic recording motion only"
                                  IsChecked="True"
                                  AutomationProperties.Name="Synthetic recording motion only" />

                        <Slider x:Name="ScaleSlider"
                                Minimum="80"
                                Maximum="200"
                                Value="125"
                                TickFrequency="25"
                                IsSnapToTickEnabled="True"
                                Margin="0,6,8,10"
                                AutomationProperties.Name="Proof scale sample slider" />

                        <UniformGrid Columns="3">
                            <Button x:Name="StartButton"
                                    Content="Start"
                                    Click="Start_Click"
                                    AutomationProperties.Name="Start proof timer" />
                            <Button x:Name="PauseButton"
                                    Content="Pause"
                                    Click="Pause_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Pause proof timer" />
                            <Button x:Name="ResetButton"
                                    Content="Reset"
                                    Click="Reset_Click"
                                    Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Reset proof timer" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="0,0,0,12">
                            <TextBlock Text="Capture field"
                                       Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="All marks, labels, motion, and sample text are generated inside Receipts."
                                       Style="{StaticResource MutedText}" />
                        </StackPanel>

                        <Canvas x:Name="DragCanvas"
                                Grid.Row="1"
                                MinHeight="390"
                                Background="#0B151C"
                                ClipToBounds="True"
                                Focusable="True"
                                AutomationProperties.Name="Safe capture field">
                            <Border Canvas.Left="24"
                                    Canvas.Top="24"
                                    Width="460"
                                    Height="300"
                                    BorderBrush="#3D5B6E"
                                    BorderThickness="1"
                                    Background="#101B23"
                                    CornerRadius="6">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="SAFE CAPTURE GRID"
                                               Foreground="{StaticResource AccentBrush}"
                                               FontWeight="Bold" />
                                    <UniformGrid Grid.Row="1"
                                                 Columns="6"
                                                 Rows="4"
                                                 Margin="0,12">
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,0,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,0,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,0,1" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,0" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,0" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,0" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,0" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,1,0" />
                                        <Border BorderBrush="#274252" BorderThickness="0,0,0,0" />
                                    </UniformGrid>
                                    <TextBlock Grid.Row="2"
                                               Text="A1 B2 C3 D4"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                </Grid>
                            </Border>

                            <Button x:Name="DragTarget"
                                    Canvas.Left="310"
                                    Canvas.Top="190"
                                    Width="166"
                                    Height="96"
                                    Background="#19313B"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2"
                                    Focusable="True"
                                    Padding="0"
                                    Margin="0"
                                    PreviewMouseLeftButtonDown="DragTarget_MouseLeftButtonDown"
                                    PreviewMouseMove="DragTarget_MouseMove"
                                    PreviewMouseLeftButtonUp="DragTarget_MouseLeftButtonUp"
                                    PreviewKeyDown="DragTarget_PreviewKeyDown"
                                    AutomationProperties.Name="Draggable proof target">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="DRAG"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Bold" />
                                    <TextBlock x:Name="DragPositionText"
                                               Grid.Row="1"
                                               Text="x310 y190"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,10"
                                               Foreground="{StaticResource MutedInkBrush}" />
                                </Grid>
                            </Button>
                        </Canvas>

                        <Grid Grid.Row="2"
                              Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="MotionProgress"
                                         Grid.Column="0"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="16"
                                         Value="35"
                                         AutomationProperties.Name="Proof timer progress" />
                            <TextBlock x:Name="TimerText"
                                       Grid.Column="1"
                                       Text="00:00.0"
                                       Margin="16,0,0,0"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       AutomationProperties.Name="Proof timer value" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button Content="Close"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButton}"
                    AutomationProperties.Name="Close proof scene" />
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
