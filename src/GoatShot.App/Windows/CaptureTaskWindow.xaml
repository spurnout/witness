<Window x:Class="GoatShot.App.Windows.CaptureTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Capture Actions"
        Width="640"
        Height="620"
        MinWidth="520"
        MinHeight="520"
        Background="#081016"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="18"
          Background="#081016">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">
            <TextBlock x:Name="TitleText"
                       Text="Capture actions"
                       FontSize="22"
                       FontWeight="Bold" />
            <TextBlock x:Name="FileNameText"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Type" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,10,8" />
                    <TextBlock x:Name="CaptureTypeText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Size" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,10,8" />
                    <TextBlock x:Name="SizeText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Privacy" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,10,8" />
                    <TextBlock x:Name="PrivacyText" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Path" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="PathText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>

                <UniformGrid Columns="2"
                             Margin="0,0,0,4">
                    <Button x:Name="OpenButton" Content="Open" Click="Action_Click" />
                    <Button x:Name="EditButton" Content="Edit" Click="Action_Click" Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="CopyButton" Content="Copy" Click="Action_Click" Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="ShareButton" Content="Share" Click="Action_Click" Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="AiButton" Content="AI" Click="Action_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="AI actions for selected capture" />
                    <Button x:Name="DocumentButton" Content="Document" Click="Action_Click" Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="ScriptDryRunButton" Content="Dry-run script" Click="Action_Click" Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="WebhookDryRunButton" Content="Dry-run webhook" Click="Action_Click" Style="{StaticResource SecondaryButton}" />
                    <Button x:Name="DeleteButton" Content="Delete local" Click="Action_Click" Style="{StaticResource DangerButton}" />
                </UniformGrid>

                <Border Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,8,8,0">
                    <TextBlock x:Name="ActionHintText"
                               Text="Choose an action for the selected capture."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedInkBrush}" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Close"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButton}"
                    AutomationProperties.Name="Close capture actions" />
        </StackPanel>
    </Grid>
</Window>
