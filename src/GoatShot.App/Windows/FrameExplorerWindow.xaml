<Window x:Class="GoatShot.App.Windows.FrameExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        Title="Receipts Frame Explorer"
        Width="1320"
        Height="850"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#081016"
        controls:AppWindowChrome.IsEnabled="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource GoatComboBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#0B151C" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="HeaderChrome"
                                Margin="0,0,4,0"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="#18313B" />
                                <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="#143C3D" />
                                <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="HeaderChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HeaderChrome" Property="Background" Value="#101922" />
                                <Setter TargetName="HeaderChrome" Property="BorderBrush" Value="#385063" />
                                <Setter Property="Foreground" Value="#7890A1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" />
        <Border DockPanel.Dock="Bottom"
                Background="#0B151C"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1,1,1,0"
                Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Loading signed replay…"
                           Margin="0,0,18,0"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="Frame Explorer status" />
                <TextBlock Grid.Column="1"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedInkBrush}"
                           Text="Integrity since local signing is verifiable for the manifest, original segments, and listed artifacts; local analysis previews and derivatives are unsigned and rebuildable. Device time, remote service state, operator identity, and legal authenticity are not independently attested." />
            </Grid>
        </Border>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Frame Explorer" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="ReceiptSummaryText"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource MutedInkBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Track" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="TrackBox"
                              Width="240"
                              SelectedValuePath="TrackId"
                              SelectionChanged="TrackBox_SelectionChanged"
                              AutomationProperties.Name="Replay source or track">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Verify"
                            Margin="10,0,0,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="Verify_Click"
                            AutomationProperties.Name="Verify original receipt" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="2*" />
                    </Grid.RowDefinitions>
                    <Border Background="Black"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            ClipToBounds="True">
                        <Grid>
                            <MediaElement x:Name="Player"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Manual"
                                          Stretch="Uniform"
                                          ScrubbingEnabled="True"
                                          MediaOpened="Player_MediaOpened"
                                          MediaEnded="Player_MediaEnded"
                                          AutomationProperties.Name="Replay video player" />
                            <Image x:Name="PlayerPreviewImage"
                                   Visibility="Collapsed"
                                   Stretch="Uniform"
                                   AutomationProperties.Name="Synthetic replay preview frame" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Before" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Image x:Name="BeforeImage" Stretch="Uniform" />
                                <TextBox x:Name="BeforeText"
                                         Margin="0,8,0,0"
                                         Height="70"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="OCR text before the possible change" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="After" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Image x:Name="AfterImage" Stretch="Uniform" />
                                <TextBox x:Name="AfterText"
                                         Margin="0,8,0,0"
                                         Height="70"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="OCR text after the possible change" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <TabControl Grid.Column="2"
                            Background="{StaticResource PanelBrush}"
                            AutomationProperties.Name="Replay scene and OCR review tabs">
                    <TabItem x:Name="ScenesTab"
                             Header="Scenes"
                             AutomationProperties.Name="Scenes">
                        <ListBox x:Name="SceneList"
                                 SelectionChanged="SceneList_SelectionChanged"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 AutomationProperties.Name="Scene markers">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding FramePath}" Height="58" Stretch="UniformToFill" />
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                            <TextBlock Text="{Binding TimeLabel}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedInkBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem x:Name="TextChangesTab"
                             Header="Possible text changes"
                             AutomationProperties.Name="Possible text changes">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8">
                                <Button Content="Confirm"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="ConfirmChange_Click" />
                                <Button Content="Dismiss"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="DismissChange_Click" />
                            </StackPanel>
                            <ListBox x:Name="ChangeList"
                                     SelectionChanged="ChangeList_SelectionChanged"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     AutomationProperties.Name="Possible OCR changes">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Text="{Binding ReviewState}" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PlayButton" Content="Play" Width="72" Style="{StaticResource SecondaryButton}" Click="Play_Click" />
                        <Button Content="◀ frame" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="PreviousFrame_Click" />
                        <Button Content="frame ▶" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="NextFrame_Click" />
                    </StackPanel>
                    <Slider x:Name="TimelineSlider"
                            Grid.Column="1"
                            Margin="12,0"
                            Minimum="0"
                            Maximum="1"
                            ValueChanged="TimelineSlider_ValueChanged"
                            MouseMove="TimelineSlider_MouseMove"
                            MouseLeave="TimelineSlider_MouseLeave"
                            AutomationProperties.Name="Replay timeline" />
                    <Canvas Grid.Column="1"
                            Panel.ZIndex="20"
                            Height="0"
                            VerticalAlignment="Top"
                            ClipToBounds="False"
                            IsHitTestVisible="False">
                        <Border x:Name="TimelineHoverPreviewBorder"
                                Canvas.Top="-150"
                                Width="230"
                                Height="142"
                                Visibility="Collapsed"
                                Background="#F20B151C"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="6"
                                AutomationProperties.Name="Timeline hover frame preview">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image x:Name="TimelineHoverImage"
                                       Stretch="Uniform"
                                       AutomationProperties.Name="Nearest locally indexed replay frame" />
                                <TextBlock x:Name="TimelineHoverText"
                                           Grid.Row="1"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource InkBrush}"
                                           AutomationProperties.Name="Timeline hover timestamp" />
                            </Grid>
                        </Border>
                    </Canvas>
                    <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center" Text="00:00 / 00:00" />
                </Grid>
                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                    <Button Content="Save current frame" Style="{StaticResource PrimaryButton}" Click="SaveFrame_Click" />
                    <CheckBox x:Name="AnalyzeScenesBox"
                              Content="Scene index"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Enable local scene indexing for this analysis" />
                    <CheckBox x:Name="AnalyzeOcrBox"
                              Content="OCR comparison"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              AutomationProperties.Name="Enable local OCR comparison for this analysis" />
                    <Button Content="Analyze locally" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="Analyze_Click" />
                    <Button Content="Mark range start" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="MarkRangeStart_Click" />
                    <Button Content="Mark range end" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="MarkRangeEnd_Click" />
                    <Button Content="Clear range" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="ClearRange_Click" />
                    <TextBlock x:Name="SelectedRangeText"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedInkBrush}"
                               Text="Range: full track"
                               AutomationProperties.Name="Selected extraction range" />
                    <Button Content="Extract unique frames" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="ExtractUnique_Click" />
                    <Button Content="Contact sheet" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="ContactSheet_Click" />
                    <Button Content="Create step guide" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="StepGuide_Click" />
                </WrapPanel>
                <Expander x:Name="TrackExportOptionsExpander"
                          Grid.Row="2"
                          Margin="0,8,0,0"
                          Header="Track export options"
                          AutomationProperties.Name="Track export options">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="ExportTrackList"
                                 MinHeight="48"
                                 MaxHeight="112"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Background="{StaticResource PanelBrush}"
                                 AutomationProperties.Name="Tracks selected for export">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Content="{Binding DisplayName}"
                                              Margin="6,4"
                                              AutomationProperties.Name="{Binding AutomationName}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Button Content="Export checked tracks"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ExportTracks_Click"
                                    AutomationProperties.Name="Export checked tracks as separate videos" />
                            <Button Content="Export composite MP4"
                                    Margin="0,8,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="ExportComposite_Click"
                                    AutomationProperties.Name="Export checked tracks as one synchronized composite video" />
                        </StackPanel>
                    </Grid>
                </Expander>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
