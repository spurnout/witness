<Window x:Class="GoatShot.App.Windows.UploadConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Share"
        Width="560"
        Height="500"
        MinWidth="460"
        MinHeight="420"
        Background="#081016"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        controls:AppWindowChrome.IsEnabled="True">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" />
    <Grid Margin="18"
          Background="#081016">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,14">
            <TextBlock Text="Confirm share"
                       FontSize="22"
                       FontWeight="Bold" />
            <TextBlock x:Name="DestinationText"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold"
                       Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="File" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,10,8" />
                    <TextBlock x:Name="FileNameText" Grid.Row="0" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Type" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,10,8" />
                    <TextBlock x:Name="CaptureTypeText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Size" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,10,8" />
                    <TextBlock x:Name="SizeText" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Path" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,10,0" />
                    <TextBlock x:Name="PathText" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap" />
                </Grid>

                <Border Background="{StaticResource PanelAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Action"
                                   Foreground="{StaticResource WarnBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="RiskText"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Background="#0B151C"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="Privacy"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6" />
                        <TextBlock x:Name="PrivacyText"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    AutomationProperties.Name="Cancel share" />
            <Button x:Name="ContinueButton"
                    Content="Continue"
                    Click="Continue_Click"
                    AutomationProperties.Name="Continue share" />
        </StackPanel>
    </Grid>
    </DockPanel>
</Window>
