<Window x:Class="GoatShot.App.Windows.AiHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoatShot AI Review"
        Width="1040"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#081016">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#061116" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Background" Value="#101B23" />
            <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="#0B151C" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style x:Key="ReviewListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#102A34" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="AI Review" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Review generated output, reuse prompts, and mark local AI actions as accepted, rejected, or iterated."
                           Foreground="{StaticResource MutedInkBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Click="Refresh_Click"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HistoryCountText"
                               FontWeight="SemiBold"
                               Margin="2,0,0,8" />
                    <ListBox x:Name="HistoryList"
                             Grid.Row="1"
                             SelectionChanged="HistoryList_SelectionChanged"
                             ItemContainerStyle="{StaticResource ReviewListItem}"
                             Background="#0B151C"
                             Foreground="{StaticResource InkBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5">
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ReviewStatus}" Foreground="{StaticResource AccentBrush}" />
                                        <TextBlock Text="  " />
                                        <TextBlock Text="{Binding ModelId}" Foreground="{StaticResource MutedInkBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <Border x:Name="EmptyDetailsPanel"
                        Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Empty AI review details">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="No AI action selected"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Run an AI action or select a history entry to review prompts, output previews, and local acceptance status."
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="EntryDetailsPanel"
                        Grid.Row="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="70" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="EntryTitleText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="EntryMetaText"
                                   Grid.Row="1"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   Margin="0,6,0,10"
                                   TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2"
                                   Text="Prompt"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="PromptText"
                                 Grid.Row="3"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8" />
                        <TextBlock Grid.Row="4"
                                   Text="Output preview"
                                   FontWeight="SemiBold"
                                   Margin="0,10,0,4" />
                        <TextBox x:Name="PreviewText"
                                 Grid.Row="5"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="72"
                                 Padding="8" />
                        <WrapPanel Grid.Row="6" Margin="0,12,0,0">
                            <Button x:Name="AcceptButton"
                                    Content="Accept"
                                    Click="Accept_Click"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button x:Name="RejectButton"
                                    Content="Reject"
                                    Click="Reject_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="IterateButton"
                                    Content="Iterate"
                                    Click="Iterate_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="CopyPromptButton"
                                    Content="Copy Prompt"
                                    Click="CopyPrompt_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="CopyPreviewButton"
                                    Content="Copy Preview"
                                    Click="CopyPreview_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="OpenOutputButton"
                                    Content="Open Output"
                                    Click="OpenOutput_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="Prompt History"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       DockPanel.Dock="Left" />
                            <ComboBox x:Name="PromptActionFilter"
                                      DockPanel.Dock="Right"
                                      Width="180"
                                      Style="{StaticResource GoatComboBox}"
                                      SelectionChanged="PromptActionFilter_SelectionChanged" />
                        </DockPanel>
                        <ListBox x:Name="PromptHistoryList"
                                 Grid.Row="1"
                                 Margin="0,8,0,8"
                                 ItemContainerStyle="{StaticResource ReviewListItem}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Background="#0B151C"
                                 Foreground="{StaticResource InkBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Prompt}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Foreground="{StaticResource MutedInkBrush}">
                                            <Run Text="{Binding Action}" />
                                            <Run Text=" uses=" />
                                            <Run Text="{Binding UseCount}" />
                                            <Run Text=" model=" />
                                            <Run Text="{Binding ModelId}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="2">
                            <Button Content="Copy Selected Prompt"
                                    Click="CopySelectedPrompt_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="Use For Iteration"
                                    Click="UsePromptForIteration_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="{StaticResource MutedInkBrush}"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <Button Content="Close"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
