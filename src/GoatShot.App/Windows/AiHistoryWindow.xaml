<Window x:Class="GoatShot.App.Windows.AiHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoatShot AI Review"
        Width="1040"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F7FAFC">
    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Background" Value="#0E7490" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#155E75" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
        <Style x:Key="ReviewListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0F2FE" />
                    <Setter Property="BorderBrush" Value="#38BDF8" />
                    <Setter Property="Foreground" Value="#0F172A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="AI Review" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Review generated output, reuse prompts, and mark local AI actions as accepted, rejected, or iterated."
                           Foreground="#475569"
                           Margin="0,4,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right"
                    Content="Refresh"
                    Click="Refresh_Click"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right" />
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D7E0E8"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="HistoryCountText"
                               FontWeight="SemiBold"
                               Margin="2,0,0,8" />
                    <ListBox x:Name="HistoryList"
                             Grid.Row="1"
                             SelectionChanged="HistoryList_SelectionChanged"
                             ItemContainerStyle="{StaticResource ReviewListItem}"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,5">
                                    <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="#0F172A" />
                                    <TextBlock Text="{Binding FileName}" Foreground="#334155" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding ReviewStatus}" Foreground="#0E7490" />
                                        <TextBlock Text="  " />
                                        <TextBlock Text="{Binding ModelId}" Foreground="#64748B" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="190" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#D7E0E8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="EntryTitleText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="EntryMetaText"
                                   Grid.Row="1"
                                   Foreground="#475569"
                                   Margin="0,6,0,10"
                                   TextWrapping="Wrap" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Prompt" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox x:Name="PromptText"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         MinHeight="74"
                                         Padding="8" />
                                <TextBlock Text="Output preview" FontWeight="SemiBold" Margin="0,12,0,4" />
                                <TextBox x:Name="PreviewText"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         MinHeight="96"
                                         Padding="8" />
                            </StackPanel>
                        </ScrollViewer>
                        <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                            <Button x:Name="AcceptButton"
                                    Content="Accept"
                                    Click="Accept_Click"
                                    Style="{StaticResource PrimaryButton}" />
                            <Button x:Name="RejectButton"
                                    Content="Reject"
                                    Click="Reject_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="IterateButton"
                                    Content="Iterate"
                                    Click="Iterate_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="CopyPromptButton"
                                    Content="Copy Prompt"
                                    Click="CopyPrompt_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="CopyPreviewButton"
                                    Content="Copy Preview"
                                    Click="CopyPreview_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button x:Name="OpenOutputButton"
                                    Content="Open Output"
                                    Click="OpenOutput_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#D7E0E8"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="Prompt History"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       DockPanel.Dock="Left" />
                            <ComboBox x:Name="PromptActionFilter"
                                      DockPanel.Dock="Right"
                                      Width="180"
                                      SelectionChanged="PromptActionFilter_SelectionChanged" />
                        </DockPanel>
                        <ListBox x:Name="PromptHistoryList"
                                 Grid.Row="1"
                                 Margin="0,8,0,8"
                                 ItemContainerStyle="{StaticResource ReviewListItem}"
                                 BorderBrush="#CBD5E1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock Text="{Binding Prompt}" TextTrimming="CharacterEllipsis" Foreground="#0F172A" />
                                        <TextBlock Foreground="#64748B">
                                            <Run Text="{Binding Action}" />
                                            <Run Text=" uses=" />
                                            <Run Text="{Binding UseCount}" />
                                            <Run Text=" model=" />
                                            <Run Text="{Binding ModelId}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Grid.Row="2">
                            <Button Content="Copy Selected Prompt"
                                    Click="CopySelectedPrompt_Click"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button Content="Use For Iteration"
                                    Click="UsePromptForIteration_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       Foreground="#334155"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <Button Content="Close"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right" />
        </DockPanel>
    </Grid>
</Window>
