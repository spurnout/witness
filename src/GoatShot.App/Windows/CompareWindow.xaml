<Window x:Class="GoatShot.App.Windows.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare captures"
        Width="1120"
        Height="720"
        MinWidth="840"
        MinHeight="540"
        Background="#081016"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        controls:AppWindowChrome.IsEnabled="True">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" />
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="VerdictText"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="ExplanationText"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MetricsText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedInkBrush}" />
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock x:Name="BeforeCaptionText"
                               DockPanel.Dock="Top"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis" />
                    <Border Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <Viewbox Stretch="Uniform" StretchDirection="Both">
                            <Grid x:Name="BeforeSurface">
                                <Image x:Name="BeforeImage"
                                       Stretch="Fill"
                                       AutomationProperties.Name="Earlier capture" />
                                <Canvas x:Name="BeforeCanvas"
                                        Background="Transparent"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Viewbox>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock x:Name="AfterCaptionText"
                               DockPanel.Dock="Top"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis" />
                    <Border Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <Viewbox Stretch="Uniform" StretchDirection="Both">
                            <Grid x:Name="AfterSurface">
                                <Image x:Name="AfterImage"
                                       Stretch="Fill"
                                       AutomationProperties.Name="Later capture" />
                                <Canvas x:Name="AfterCanvas"
                                        Background="Transparent"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </Viewbox>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
