<Window x:Class="GoatShot.App.Windows.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare captures"
        Width="1120"
        Height="720"
        MinWidth="840"
        MinHeight="540"
        Background="#081016"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        controls:AppWindowChrome.IsEnabled="True">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" />
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="VerdictText"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="ExplanationText"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MetricsText"
                           Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource MutedInkBrush}" />
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Fit" Click="FitImages_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Fit comparison images" />
                    <Button Content="100%" Click="ActualSize_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Show comparison at 100 percent" />
                    <Button Content="−" Click="ZoomOut_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Zoom out comparison" />
                    <Button Content="+" Click="ZoomIn_Click" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Zoom in comparison" />
                    <TextBlock x:Name="ImageZoomText" Margin="8,0,16,8" VerticalAlignment="Center" AutomationProperties.Name="Comparison zoom level" />
                    <CheckBox x:Name="SyncViewportsBox" Content="Sync zoom and pan" IsChecked="True" Checked="SyncViewports_Changed" Margin="0,0,16,8" VerticalAlignment="Center" />
                    <TextBlock Text="Drag to pan · Ctrl+wheel to zoom" VerticalAlignment="Center" Foreground="{StaticResource MutedInkBrush}" Margin="0,0,0,8" />
                </WrapPanel>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock x:Name="BeforeCaptionText"
                               DockPanel.Dock="Top"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis" />
                    <Border Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <ScrollViewer x:Name="BeforeViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Earlier image viewport">
                            <Grid x:Name="BeforeZoomContainer" Width="{Binding ElementName=BeforeSurface, Path=Width}" Height="{Binding ElementName=BeforeSurface, Path=Height}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="BeforeSurface">
                                <Image x:Name="BeforeImage"
                                       Stretch="Fill"
                                       AutomationProperties.Name="Earlier capture" />
                                <Canvas x:Name="BeforeCanvas"
                                        Background="Transparent"
                                        IsHitTestVisible="False" />
                            </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock x:Name="AfterCaptionText"
                               DockPanel.Dock="Top"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis" />
                    <Border Background="{StaticResource PanelAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8">
                        <ScrollViewer x:Name="AfterViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Later image viewport">
                            <Grid x:Name="AfterZoomContainer" Width="{Binding ElementName=AfterSurface, Path=Width}" Height="{Binding ElementName=AfterSurface, Path=Height}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid x:Name="AfterSurface">
                                <Image x:Name="AfterImage"
                                       Stretch="Fill"
                                       AutomationProperties.Name="Later capture" />
                                <Canvas x:Name="AfterCanvas"
                                        Background="Transparent"
                                        IsHitTestVisible="False" />
                            </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
