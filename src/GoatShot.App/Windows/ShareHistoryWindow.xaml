<Window x:Class="GoatShot.App.Windows.ShareHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share History"
        Width="920"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        Background="#081016"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        controls:AppWindowChrome.IsEnabled="True">
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" />
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Share history"
                           FontSize="22"
                           FontWeight="Bold" />
                <TextBlock Text="Local upload records and queued retry actions"
                           Foreground="{StaticResource MutedInkBrush}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBox x:Name="SearchBox"
                         MinHeight="36"
                         Margin="0,0,0,6"
                         TextChanged="SearchBox_TextChanged"
                         AutomationProperties.Name="Search share history" />
                <UniformGrid Columns="2">
                    <ComboBox x:Name="StatusFilterBox"
                              SelectedIndex="0"
                              SelectionChanged="Filter_SelectionChanged"
                              Background="#0B151C"
                              Foreground="#081016"
                              AutomationProperties.Name="Share status filter"
                              Margin="0,0,8,0">
                        <ComboBoxItem Content="All statuses" />
                        <ComboBoxItem Content="Succeeded" />
                        <ComboBoxItem Content="Failed" />
                    </ComboBox>
                    <ComboBox x:Name="DestinationFilterBox"
                              SelectedIndex="0"
                              SelectionChanged="Filter_SelectionChanged"
                              Background="#0B151C"
                              Foreground="#081016"
                              AutomationProperties.Name="Share destination filter">
                        <ComboBoxItem Content="All destinations" />
                        <ComboBoxItem Content="External only" />
                        <ComboBoxItem Content="Local only" />
                        <ComboBoxItem Content="ClipboardImage" />
                        <ComboBoxItem Content="MarkdownImageLink" />
                        <ComboBoxItem Content="LocalFolder" />
                        <ComboBoxItem Content="S3Compatible" />
                        <ComboBoxItem Content="Imgur" />
                        <ComboBoxItem Content="Cloudinary" />
                        <ComboBoxItem Content="Dropbox" />
                        <ComboBoxItem Content="GoogleDrive" />
                        <ComboBoxItem Content="OneDrive" />
                        <ComboBoxItem Content="Linear" />
                    </ComboBox>
                </UniformGrid>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="HistoryCountText"
                           Grid.Row="0"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />
                <ListView x:Name="HistoryList"
                          Grid.Row="1"
                          Background="#081016"
                          BorderBrush="{StaticResource BorderBrush}"
                          Foreground="{StaticResource InkBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="HistoryList_SelectionChanged"
                          AutomationProperties.Name="Share history list">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8">
                                <StackPanel>
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="{Binding StatusText}"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontWeight="SemiBold"
                                                   Margin="10,0,0,0" />
                                        <TextBlock Text="{Binding FileName}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ShortId, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding CreatedText, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding DestinationText, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding ScopeText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12"
                                               TextWrapping="WrapWithOverflow"
                                               MaxHeight="46" />
                                    <TextBlock Text="{Binding UrlText}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <WrapPanel Grid.Row="2"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Left">
                    <Button x:Name="CopyUrlButton"
                            Content="Copy URL"
                            Click="CopyUrl_Click"
                            AutomationProperties.Name="Copy share history URL" />
                    <Button x:Name="OpenUrlButton"
                            Content="Open URL"
                            Click="OpenUrl_Click"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Open share history URL" />
                    <Button x:Name="CopyMarkdownButton"
                            Content="Copy Markdown"
                            Click="CopyMarkdown_Click"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Copy share history Markdown" />
                    <Button x:Name="RetryHistoryButton"
                            Content="Queue retry"
                            Click="RetryHistory_Click"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Queue retry from share history" />
                </WrapPanel>
            </Grid>

        </Grid>

        <Expander Grid.Row="2"
                  Header="Upload Queue"
                  IsExpanded="False"
                  Margin="0,14,0,0">
            <Grid Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="QueueSummaryText"
                           Grid.Row="0"
                           Foreground="{StaticResource AccentBrush}"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8" />
                <ListView x:Name="QueueList"
                          Grid.Row="1"
                          Background="#081016"
                          BorderBrush="{StaticResource BorderBrush}"
                          Foreground="{StaticResource InkBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          SelectionChanged="QueueList_SelectionChanged"
                          AutomationProperties.Name="Share history upload queue list">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding FileName}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12">
                                        <Run Text="{Binding ShortId, Mode=OneWay}" />
                                        <Run Text=" | " />
                                        <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding AttemptLabel}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12" />
                                    <TextBlock Text="{Binding NextAttemptLabel}"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <WrapPanel Grid.Row="2"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Left">
                    <Button Content="Refresh"
                            Click="Refresh_Click"
                            AutomationProperties.Name="Refresh share history" />
                    <Button x:Name="CancelQueueButton"
                            Content="Cancel selected"
                            Click="CancelQueue_Click"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Cancel selected queued upload" />
                    <Button x:Name="RetryQueueButton"
                            Content="Retry selected"
                            Click="RetryQueue_Click"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Retry selected queued upload" />
                </WrapPanel>
            </Grid>
        </Expander>

        <DockPanel Grid.Row="3"
                   Margin="0,14,0,0">
            <TextBlock x:Name="StatusText"
                       DockPanel.Dock="Left"
                       Foreground="{StaticResource MutedInkBrush}"
                       TextWrapping="Wrap" />
            <Button Content="Close"
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Click="Close_Click"
                    Style="{StaticResource SecondaryButton}"
                    AutomationProperties.Name="Close share history" />
        </DockPanel>
    </Grid>
    </DockPanel>
</Window>
