<Window x:Class="GoatShot.App.Windows.PinnedCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pinned Receipts Capture"
        Width="680"
        Height="440"
        MinWidth="260"
        MinHeight="180"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        controls:AppWindowChrome.IsEnabled="True"
        controls:AppWindowChrome.CaptionHeight="0">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0B151C"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Opacity"
                               Foreground="{StaticResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,8" />
                    <Slider x:Name="OpacitySlider"
                            Width="120"
                            Minimum="0.35"
                            Maximum="1"
                            Value="1"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="False"
                            ValueChanged="OpacitySlider_ValueChanged"
                            AutomationProperties.Name="Pinned window opacity"
                            AutomationProperties.HelpText="Adjust how transparent the pinned capture window is"
                            Margin="0,0,10,8" />
                    <Button Content="Close"
                            Click="Close_Click"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>

                <TextBlock x:Name="PinnedTitle"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           AutomationProperties.Name="Pinned capture title" />
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#050B10"
                Padding="10">
            <Image x:Name="PinnedImage"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   AutomationProperties.Name="Pinned capture image" />
        </Border>
    </Grid>
</Window>
