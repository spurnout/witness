<Window x:Class="GoatShot.App.Windows.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipts Editor"
        Width="1200"
        Height="820"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="EditorWindow_PreviewKeyDown"
        xmlns:controls="clr-namespace:GoatShot.App.Controls"
        controls:AppWindowChrome.IsEnabled="True">
    <Window.Resources>
        <Style x:Key="EditorToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="AutomationProperties.HelpText" Value="Editor annotation tool" />
        </Style>
        <Style x:Key="PrivacyToolButton" TargetType="Button" BasedOn="{StaticResource EditorToolButton}">
            <Setter Property="Background" Value="#321820" />
            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
            <Setter Property="Foreground" Value="#FFE9BD" />
            <Setter Property="AutomationProperties.HelpText" Value="Privacy masking editor tool" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <controls:AppTitleBar DockPanel.Dock="Top" />
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#0B151C"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0">
                        <Border Background="#101B23"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="Annotate"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="12"
                                           Margin="2,0,0,6" />
                                <WrapPanel>
                                    <Button x:Name="RectangleToolButton" Content="▭" ToolTip="Rectangle" AutomationProperties.Name="Rectangle" AutomationProperties.HelpText="Rectangle annotation tool" Tag="Rectangle" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="EllipseToolButton" Content="○" ToolTip="Ellipse" AutomationProperties.Name="Ellipse" AutomationProperties.HelpText="Ellipse annotation tool" Tag="Ellipse" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="LineToolButton" Content="/" ToolTip="Line" AutomationProperties.Name="Line" AutomationProperties.HelpText="Line annotation tool" Tag="Line" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="ArrowToolButton" Content="→" ToolTip="Arrow" AutomationProperties.Name="Arrow" AutomationProperties.HelpText="Arrow annotation tool" Tag="Arrow" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="FreehandToolButton" Content="✎" ToolTip="Freehand pen" AutomationProperties.Name="Freehand pen" AutomationProperties.HelpText="Freehand pen annotation tool" Tag="Freehand" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="TextToolButton" Content="T" ToolTip="Text" AutomationProperties.Name="Text" AutomationProperties.HelpText="Text annotation tool" Tag="Text" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="CalloutToolButton" Content="!" ToolTip="Callout note" AutomationProperties.Name="Callout note" AutomationProperties.HelpText="Callout note annotation tool" Tag="Callout" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="StepToolButton" Content="#" ToolTip="Step marker" AutomationProperties.Name="Step marker" AutomationProperties.HelpText="Step marker annotation tool" Tag="Step" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="HighlightToolButton" Content="H" ToolTip="Highlight" AutomationProperties.Name="Highlight" AutomationProperties.HelpText="Highlight annotation tool" Tag="Highlight" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="SpotlightToolButton" Content="◉" ToolTip="Spotlight" AutomationProperties.Name="Spotlight" AutomationProperties.HelpText="Spotlight annotation tool" Tag="Spotlight" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                    <Button x:Name="CropToolButton" Content="⌗" ToolTip="Crop" AutomationProperties.Name="Crop" AutomationProperties.HelpText="Crop annotation tool" Tag="Crop" Click="Tool_Click" Style="{StaticResource EditorToolButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#180E13"
                                BorderBrush="{StaticResource WarnBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,6"
                                Margin="0,0,10,8"
                                AutomationProperties.Name="Privacy masking tools">
                            <StackPanel>
                                <TextBlock Text="Privacy"
                                           Foreground="{StaticResource WarnBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Margin="2,0,0,6" />
                                <WrapPanel>
                                    <Button x:Name="RedactToolButton" Content="█" ToolTip="Solid redaction" AutomationProperties.Name="Solid redaction" AutomationProperties.HelpText="Solid redaction privacy masking tool" Tag="Redact" Click="Tool_Click" Style="{StaticResource PrivacyToolButton}" />
                                    <Button x:Name="BlurToolButton" Content="~" ToolTip="Blur selected area" AutomationProperties.Name="Blur selected area" AutomationProperties.HelpText="Blur selected area privacy masking tool" Tag="Blur" Click="Tool_Click" Style="{StaticResource PrivacyToolButton}" />
                                    <Button x:Name="PixelateToolButton" Content="▦" ToolTip="Pixelate selected area" AutomationProperties.Name="Pixelate selected area" AutomationProperties.HelpText="Pixelate selected area privacy masking tool" Tag="Pixelate" Click="Tool_Click" Style="{StaticResource PrivacyToolButton}" />
                                    <Button x:Name="ReviewSensitiveRegionsButton" Content="OCR" ToolTip="Review OCR-sensitive regions" AutomationProperties.Name="Review OCR-sensitive regions" AutomationProperties.HelpText="Review OCR-sensitive regions privacy masking tool" Click="ReviewSensitiveRegions_Click" Style="{StaticResource PrivacyToolButton}" />
                                    <Button x:Name="ApplySensitiveRegionsButton" Content="Apply" ToolTip="Apply OCR-sensitive redactions" AutomationProperties.Name="Apply OCR-sensitive redactions" AutomationProperties.HelpText="Apply OCR-sensitive redactions privacy masking tool" Click="ApplySensitiveRegions_Click" Style="{StaticResource PrivacyToolButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#101B23"
                                BorderBrush="{StaticResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,7"
                                MinWidth="148"
                                Margin="0,0,10,8">
                            <StackPanel>
                                <TextBlock Text="Active tool"
                                           Foreground="{StaticResource MutedInkBrush}"
                                           FontSize="12" />
                                <TextBlock x:Name="ActiveToolText"
                                           Text="Rectangle"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           AutomationProperties.Name="Active editor tool"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                <WrapPanel Grid.Row="1" HorizontalAlignment="Right">
                    <TextBlock Text="AI prompt"
                               Foreground="{StaticResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,8" />
                    <TextBox x:Name="AiPromptBox"
                             Width="320"
                             Margin="0,0,8,8"
                             AutomationProperties.Name="AI edit prompt"
                             ToolTip="Gemini edit prompt" />
                    <Button Content="Use last prompt" Click="UseLastAiPrompt_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="AI edit" Click="AiEdit_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Undo" Click="Undo_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Redo" Click="Redo_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Copy" Click="Copy_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Export..." Click="Export_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Print" Click="Print_Click" Style="{StaticResource SecondaryButton}" />
                    <Button Content="Save copy" Click="Save_Click" />
                </WrapPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#050B10"
                Padding="16">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="EditorSurface"
                      Background="Transparent"
                      Focusable="True"
                      AutomationProperties.Name="Screenshot annotation canvas"
                      MouseLeftButtonDown="EditorSurface_MouseLeftButtonDown"
                      MouseMove="EditorSurface_MouseMove"
                      MouseLeftButtonUp="EditorSurface_MouseLeftButtonUp"
                      ClipToBounds="True">
                    <Image x:Name="BaseImage"
                           Stretch="None"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Canvas x:Name="AnnotationCanvas"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                </Grid>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Background="#0B151C"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,8">
            <TextBlock x:Name="ToolStatus"
                       AutomationProperties.Name="Editor tool status"
                       AutomationProperties.LiveSetting="Polite"
                       Foreground="{StaticResource MutedInkBrush}"
                       Text="Rectangle tool active. Drag on the image to annotate." />
        </Border>
    </Grid>
    </DockPanel>
</Window>
