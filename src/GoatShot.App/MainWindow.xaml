<Window x:Class="GoatShot.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GoatShot"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="620"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#091118"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Capture"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,10" />
                        <Border Style="{StaticResource QuietCardBorder}"
                                Padding="10"
                                Margin="0,0,8,10">
                            <StackPanel>
                                <Button Click="ScreenAction_Click"
                                        Style="{StaticResource IconActionButton}"
                                        AutomationProperties.Name="Start screen capture"
                                        ToolTip="Capture the selected screen target">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="&#xE722;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Screen"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                    </DockPanel>
                                </Button>
                                <ComboBox x:Name="ScreenCaptureTypeBox"
                                          AutomationProperties.Name="Screen capture target"
                                          Style="{StaticResource GoatComboBox}"
                                          SelectedIndex="0"
                                          Margin="0,8,0,0"
                                          ToolTip="Choose area, window, monitor, or scrolling capture before pressing Screen.">
                                    <ComboBoxItem Content="Area / region" Tag="Region" />
                                    <ComboBoxItem Content="Window" Tag="ActiveWindow" />
                                    <ComboBoxItem Content="Scrolling window" Tag="ScrollingWindow" />
                                    <ComboBoxItem Content="Horizontal scrolling" Tag="HorizontalScrolling" />
                                    <ComboBoxItem Content="Fullscreen" Tag="Fullscreen" />
                                    <ComboBoxItem Content="All monitors" Tag="AllMonitors" />
                                    <ComboBoxItem Content="Active monitor" Tag="ActiveMonitor" />
                                    <ComboBoxItem Content="Last region" Tag="LastRegion" />
                                    <ComboBoxItem Content="Delayed area" Tag="DelayedRegion" />
                                    <ComboBoxItem Content="Preset 1280 x 720" Tag="Preset1280" />
                                    <ComboBoxItem Content="Preset 1920 x 1080" Tag="Preset1920" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border x:Name="RecordingControlsAuditSection"
                                AutomationProperties.Name="Recording controls"
                                Style="{StaticResource QuietCardBorder}"
                                Padding="10"
                                Margin="0,0,8,10">
                            <StackPanel>
                                <Button Click="VideoAction_Click"
                                        Style="{StaticResource IconActionButton}"
                                        AutomationProperties.Name="Start or stop video recording"
                                        ToolTip="Record the selected video target">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="&#xE714;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="16"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="Video"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                    </DockPanel>
                                </Button>
                                <ComboBox x:Name="VideoCaptureTypeBox"
                                          AutomationProperties.Name="Video recording target"
                                          Style="{StaticResource GoatComboBox}"
                                          SelectedIndex="0"
                                          Margin="0,8,0,8"
                                          ToolTip="Choose smooth GIF or quick MP4 target before pressing Video.">
                                    <ComboBoxItem Content="GIF monitor" Tag="GifMonitor" />
                                    <ComboBoxItem Content="GIF area" Tag="GifRegion" />
                                    <ComboBoxItem Content="GIF window" Tag="GifWindow" />
                                    <ComboBoxItem Content="GIF all monitors" Tag="GifAllMonitors" />
                                    <ComboBoxItem Content="MP4 monitor" Tag="Mp4Monitor" />
                                    <ComboBoxItem Content="MP4 area" Tag="Mp4Region" />
                                    <ComboBoxItem Content="MP4 window" Tag="Mp4Window" />
                                    <ComboBoxItem Content="MP4 all monitors" Tag="Mp4AllMonitors" />
                                </ComboBox>
                                <Button Content="Pause / resume video"
                                        Click="PauseRecording_Click"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Border>

                        <Expander Header="Direct capture buttons"
                                  IsExpanded="False"
                                  Margin="0,0,8,10">
                            <StackPanel Margin="0,8,0,0">
                                <Button Content="All-in-one region" Click="CaptureRegion_Click" />
                                <Button Content="Active window"
                                        Click="CaptureWindow_Click"
                                        ToolTip="Temporarily hides GoatShot, then captures the foreground app behind it." />
                                <Button Content="Scrolling window" Click="CaptureScrollingWindow_Click" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Horizontal scrolling" Click="CaptureHorizontalScrollingWindow_Click" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Fullscreen" Click="CaptureFullscreen_Click" />
                                <Button Content="All monitors" Click="CaptureAllMonitors_Click" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Active monitor" Click="CaptureMonitor_Click" />
                                <Button Content="Preset 1280 x 720" Click="CapturePreset1280x720_Click" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Preset 1920 x 1080" Click="CapturePreset1920x1080_Click" Style="{StaticResource SecondaryButton}" />
                                <Button Content="Last region" Click="CaptureLastRegion_Click" />
                                <Button Content="Delayed region" Click="CaptureDelayed_Click" Style="{StaticResource SecondaryButton}" />
                                <Separator Margin="0,8,0,12" Background="{StaticResource BorderBrush}" />
                                <Button Content="Start / stop GIF" Click="Recording_Click" ToolTip="Record a local GIF using saved FPS settings. GIF timing is capped by the format." />
                            <Button Content="Pause / resume recording" Click="PauseRecording_Click" Style="{StaticResource SecondaryButton}" />
                            <Button Content="Quick MP4 5s" Click="RecordMp4_Click" Style="{StaticResource SecondaryButton}" />
                            <Button Content="All monitors MP4 5s" Click="RecordAllMonitorsMp4_Click" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="Recording &amp; camera"
                                  IsExpanded="False"
                                  Margin="0,0,8,10">
                            <StackPanel Margin="0,8,0,0">
                                <Border Background="#071016"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,10">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="Camera preview"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{StaticResource InkBrush}"
                                                   Margin="0,0,0,6" />
                                        <Button x:Name="WebcamPreviewButton"
                                                Content="Start preview"
                                                AutomationProperties.Name="Start or stop camera preview"
                                                Click="ToggleWebcamPreview_Click"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <TextBlock x:Name="WebcamPreviewStatusText"
                                               Text="Preview stopped."
                                               AutomationProperties.Name="Camera preview status"
                                               AutomationProperties.LiveSetting="Polite"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12"
                                               Margin="0,0,0,6" />
                                    <Border Height="52"
                                            Background="#02070B"
                                            BorderBrush="#1D3440"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Image x:Name="WebcamPreviewImage"
                                               AutomationProperties.Name="Camera preview frame"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>
                                </StackPanel>
                                </Border>
                                <StackPanel>
                            <Border Background="#0D222B"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,2,8,10">
                                <StackPanel>
                                    <TextBlock Text="Current setup"
                                               Foreground="{StaticResource InkBrush}"
                                               FontWeight="SemiBold"
                                               FontSize="12"
                                               Margin="0,0,0,4" />
                                    <TextBlock x:Name="RecordingSetupText"
                                               AutomationProperties.Name="Recording setup summary"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               FontSize="12"
                                               LineHeight="17"
                                               Text="State: idle." />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="Saved profile"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       Margin="0,4,8,4" />
                            <Grid Margin="0,0,8,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="74" />
                                </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RecordingProfileBox"
                                      Grid.Column="0"
                                      AutomationProperties.Name="Saved recording profile"
                                      Style="{StaticResource GoatComboBox}" />
                                <Button Grid.Column="1"
                                        Content="Apply"
                                        Click="ApplyRecordingProfile_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Text="MP4 profile"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       Margin="0,4,8,4" />
                            <ComboBox x:Name="RecordingQualityBox"
                                      AutomationProperties.Name="MP4 quality profile"
                                      Margin="0,0,8,8"
                                      Style="{StaticResource GoatComboBox}"
                                      SelectionChanged="RecordingControl_Changed">
                                <ComboBoxItem Content="Small" />
                                <ComboBoxItem Content="Balanced" />
                                <ComboBoxItem Content="High quality" />
                                <ComboBoxItem Content="Archive" />
                            </ComboBox>
                            <TextBlock Text="FPS"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,4" />
                            <TextBox x:Name="RecordingFpsBox"
                                     AutomationProperties.Name="Recording frames per second"
                                     Margin="0,0,8,8"
                                     LostFocus="RecordingControl_Changed"
                                     ToolTip="Source recording FPS for MP4/WebM and GIF capture. GIF playback is capped by 10 ms timing steps." />
                            <TextBlock Text="Target size"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,4" />
                            <TextBox x:Name="RecordingSizeBox"
                                     AutomationProperties.Name="Recording target size"
                                     Margin="0,0,8,8"
                                     LostFocus="RecordingControl_Changed"
                                     ToolTip="Optional MP4 size such as 1280x720. Leave blank for source/max fallback size." />
                            <TextBlock Text="Bitrate"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,4" />
                            <TextBox x:Name="RecordingBitrateBox"
                                     AutomationProperties.Name="Recording bitrate"
                                     Margin="0,0,8,8"
                                     LostFocus="RecordingControl_Changed"
                                     ToolTip="Optional bitrate such as 6000k or 8M. Leave blank for profile CRF." />
                            <CheckBox x:Name="RecordingMicBox" Content="Mic audio" Checked="RecordingControl_Changed" Unchecked="RecordingControl_Changed" />
                            <CheckBox x:Name="RecordingSystemAudioBox" Content="System audio" Checked="RecordingControl_Changed" Unchecked="RecordingControl_Changed" />
                            <CheckBox x:Name="RecordingWebcamBox" Content="Webcam overlay" Checked="RecordingControl_Changed" Unchecked="RecordingControl_Changed" />
                            <CheckBox x:Name="RecordingCountdownBox" Content="Countdown" Checked="RecordingControl_Changed" Unchecked="RecordingControl_Changed" />
                            <CheckBox x:Name="RecordingBorderBox" Content="Border" Checked="RecordingControl_Changed" Unchecked="RecordingControl_Changed" />
                            <CheckBox x:Name="RecordingTimerBox" Content="Timer" Checked="RecordingControl_Changed" Unchecked="RecordingControl_Changed" />
                            <CheckBox x:Name="RecordingKeystrokeBox" Content="Keys" Checked="RecordingControl_Changed" Unchecked="RecordingControl_Changed" />
                            <Button Content="Start / stop step recorder" Click="StepRecorder_Click" Style="{StaticResource SecondaryButton}" />
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       Margin="0,0,8,14"
                                       Text="Captures active-window screenshots on workflow clicks and exports Markdown/HTML guides." />
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <Separator Margin="0,10,8,16" Background="{StaticResource BorderBrush}" />

                        <Expander Header="More tools" IsExpanded="False">
                            <StackPanel Margin="0,8,0,0">
                        <Button Content="Quick actions" Click="CaptureTask_Click" />
                        <Button Content="Open editor" Click="OpenEditor_Click" />
                        <Button Content="Import clipboard" Click="ImportClipboard_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Combine selected" Click="CombineSelected_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Pin to screen" Click="PinCapture_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Copy image" Click="CopyImage_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Copy file" Click="CopyFile_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Copy path" Click="CopyPath_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Copy markdown" Click="CopyMarkdown_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Show in Explorer" Click="ShowInExplorer_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Quick share" Click="QuickShare_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Share history" Click="ShareHistory_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Export bug report" Click="ExportBugReport_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Explain with AI" Click="AiExplain_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="AI history" Click="AiHistory_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Export video frame" Click="ExportVideoFrame_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Trim first 5s" Click="TrimVideo_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Mute video" Click="MuteVideo_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Volume 150%" Click="VolumeVideo_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Speed 2x" Click="SpeedVideo_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Crop center 75%" Click="CropVideo_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Resize 720p" Click="ResizeVideo_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Cut 2s middle" Click="CutVideo_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Smooth GIF 60" Click="ConvertVideo_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Strip metadata" Click="StripMetadata_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="File details" Click="FileDetails_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Run OCR" Click="RunOcr_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Redact OCR secrets" Click="RedactOcrSecrets_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Scan text" Click="ScanText_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Decode QR/barcode" Click="DecodeBarcode_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Pick color" Click="ColorPicker_Click" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Pixel ruler" Click="PixelRuler_Click" Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Workspace"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Search captures"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="SearchBox"
                                 TextChanged="SearchBox_TextChanged"
                                 Margin="0,0,0,12"
                                 AutomationProperties.Name="Search captures"
                                 ToolTip="Filter captures by file, type, notes, or OCR text." />
                    </StackPanel>

                    <Border x:Name="EmptyState"
                            Background="#0B151C"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Visibility="Collapsed"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            Margin="18"
                            AutomationProperties.Name="Empty workspace guidance">
                        <StackPanel>
                            <TextBlock Text="Capture -> Edit/Redact -> Share"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Start with PrintScreen, a region capture, or clipboard import. Captures stay local until you choose a share action."
                                       Foreground="{StaticResource MutedInkBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,12" />
                            <StackPanel>
                                <Button Content="Screen region"
                                        Click="CaptureRegion_Click"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Capture screen region from empty workspace" />
                                <Button Content="Import clipboard"
                                        Click="ImportClipboard_Click"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Import clipboard from empty workspace" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="CaptureList"
                             AutomationProperties.Name="Capture workspace list"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource InkBrush}"
                             SelectionMode="Extended"
                             SelectionChanged="CaptureList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8"
                                        Margin="0,0,0,10"
                                        Background="#0B151C">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="82"
                                                Height="58"
                                                Background="#071016"
                                                BorderBrush="#1D3440"
                                                BorderThickness="1">
                                            <Image Source="{Binding ThumbnailPath}"
                                                   Stretch="Uniform" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SizeLabel}"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding FileName}"
                                                       Foreground="{StaticResource MutedInkBrush}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="#081016"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Preview"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   DockPanel.Dock="Left" />
                        <TextBlock x:Name="PreviewHint"
                                   AutomationProperties.Name="Preview status"
                                   Text="Select a capture"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   HorizontalAlignment="Right" />
                    </DockPanel>
                    <Border Grid.Row="1"
                            Style="{StaticResource QuietCardBorder}"
                            Padding="10"
                            Margin="0,0,0,12">
                        <UniformGrid Columns="2">
                            <Button Click="OpenEditor_Click"
                                    Style="{StaticResource PreviewActionButton}"
                                    AutomationProperties.Name="Edit selected capture"
                                    ToolTip="Open the selected capture in the editor">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" />
                                    <TextBlock Text="Edit" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Click="CopyImage_Click"
                                    Style="{StaticResource PreviewActionButton}"
                                    AutomationProperties.Name="Copy selected capture"
                                    ToolTip="Copy the selected image to the clipboard">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" />
                                    <TextBlock Text="Copy" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Click="QuickShare_Click"
                                    Style="{StaticResource PreviewActionButton}"
                                    AutomationProperties.Name="Share selected capture"
                                    ToolTip="Upload or share using the configured destination">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" />
                                    <TextBlock Text="Share" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Click="RedactOcrSecrets_Click"
                                    Style="{StaticResource PreviewActionButton}"
                                    AutomationProperties.Name="Create privacy-redacted copy"
                                    ToolTip="Detect text and create a redacted copy">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" />
                                    <TextBlock Text="Privacy" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Click="ExportBugReport_Click"
                                    Style="{StaticResource PreviewActionButton}"
                                    AutomationProperties.Name="Create capture document"
                                    ToolTip="Create a Markdown/HTML handoff document">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" />
                                    <TextBlock Text="Document" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                            <Button Click="CaptureTask_Click"
                                    Style="{StaticResource PreviewActionButton}"
                                    AutomationProperties.Name="Open capture action palette"
                                    ToolTip="Open the full action palette for this capture">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" HorizontalAlignment="Center" />
                                    <TextBlock Text="More" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Border>
                    <Border Grid.Row="2"
                            Background="#050B10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Image x:Name="PreviewImage"
                                   AutomationProperties.Name="Selected capture preview"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="3"
                    Background="{StaticResource PanelBrush}"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Privacy default"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="Captures stay local unless you copy, export, or configure a share action. AI is disabled until configured."
                                   Foreground="{StaticResource MutedInkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14" />

                        <Expander Header="Health / Details" IsExpanded="False">
                            <Border Style="{StaticResource QuietCardBorder}" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock Text="Capture truth"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Margin="0,0,0,12" />
                                    <TextBlock x:Name="DetailsText"
                                               AutomationProperties.Name="Selected capture details"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,18" />

                                    <TextBlock Text="Hotkeys"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="0,0,0,8" />
                                    <TextBlock x:Name="HotkeyText"
                                               AutomationProperties.Name="Hotkey registration status"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,18" />

                                    <TextBlock Text="Runtime status"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="0,0,0,8" />
                                    <TextBlock x:Name="DiagnosticsText"
                                               AutomationProperties.Name="Runtime diagnostics summary"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />
                                    <Button Content="Copy diagnostic bundle"
                                            Click="DiagnosticBundle_Click"
                                            Style="{StaticResource SecondaryButton}"
                                            Margin="0,0,0,18" />

                                    <TextBlock Text="Upload queue"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource AccentBrush}"
                                               Margin="0,0,0,8" />
                                    <TextBlock x:Name="QueueStatusText"
                                               AutomationProperties.Name="Upload queue status"
                                               Foreground="{StaticResource MutedInkBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8" />
                                    <ListBox x:Name="QueueList"
                                             AutomationProperties.Name="Upload queue list"
                                             Background="#081016"
                                             BorderBrush="{StaticResource BorderBrush}"
                                             Foreground="{StaticResource InkBrush}"
                                             MaxHeight="180"
                                             Margin="0,0,0,8">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="4,6">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Foreground="{StaticResource MutedInkBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                                            <Run Text=" via " />
                                                            <Run Text="{Binding Destination, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Foreground="{StaticResource MutedInkBrush}"
                                                                   FontSize="12"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding AttemptLabel, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding NextAttemptLabel}"
                                                                   Foreground="{StaticResource MutedInkBrush}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding LastMessage}"
                                                                   Foreground="{StaticResource MutedInkBrush}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <UniformGrid Columns="2">
                                        <Button Content="Refresh queue"
                                                Click="RefreshQueue_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button Content="Process due"
                                                Click="ProcessQueue_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button Content="Cancel selected"
                                                Click="CancelQueueItem_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button Content="Retry selected"
                                                Click="RetryQueueItem_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="#0B151C"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Image Source="Assets/goatshot-logo.png"
                           Width="18"
                           Height="18"
                           Margin="0,0,8,0"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="GoatShot logo" />
                    <TextBlock x:Name="StatusText"
                               AutomationProperties.Name="Application status"
                               AutomationProperties.LiveSetting="Polite"
                               Foreground="{StaticResource MutedInkBrush}"
                               VerticalAlignment="Center"
                               Text="Ready" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Click="Settings_Click"
                            Style="{StaticResource SecondaryButton}"
                            Width="34"
                            Height="30"
                            Padding="0"
                            Margin="0,0,6,0"
                            ToolTip="Settings"
                            AutomationProperties.Name="Open settings">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" />
                    </Button>
                    <Button Click="Diagnostics_Click"
                            Style="{StaticResource SecondaryButton}"
                            Width="34"
                            Height="30"
                            Padding="0"
                            Margin="0"
                            ToolTip="Diagnostics"
                            AutomationProperties.Name="Open diagnostics">
                        <TextBlock Text="&#xE9D9;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
